# .env.example — Copiar a variables de entorno en Hostinger (hPanel)
# NUNCA commitear el archivo .env real con secretos al repositorio.

NODE_ENV=production
PORT=3000
API_TOKEN=
META_PIXEL_ID=280967147554736
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# ─────────────────────────────────────────────────────────────
# AVISO DE LEADS AGENDADOS
#
# Dónde se guardan las citas. Ruta relativa a la raíz de la app.
# NO la pongas dentro de data/: deploy.sh sincroniza con
# "rsync --delete" incluyendo data/***, y borraría los leads en el
# siguiente deploy. var/ no está en la lista de includes, así que
# sobrevive.
BOOKINGS_FILE=var/bookings.jsonl

# Los tres canales siguientes son OPCIONALES e INDEPENDIENTES.
# Puedes activar uno, dos o los tres. Si no activas ninguno, las
# citas se siguen guardando en el archivo pero nadie recibe aviso.

# ── 1. Telegram (recomendado: gratis y llega al teléfono al instante)
# Cómo obtenerlo:
#   1) En Telegram busca @BotFather y manda /newbot
#   2) Copia el token que te da → TELEGRAM_BOT_TOKEN
#   3) Escríbele cualquier mensaje a tu bot nuevo
#   4) Abre https://api.telegram.org/bot<TU_TOKEN>/getUpdates
#      y copia el valor de "chat":{"id": ...} → TELEGRAM_CHAT_ID
#   Para avisar a varias personas: crea un grupo, agrega el bot y
#   usa el id del grupo (empieza con -100).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 2. Webhook genérico (Make.com, Zapier, n8n, Slack, Discord,
#      Google Sheets). Recibe POST con { text, content, lead }.
#      "text" y "content" van duplicados para que funcione tal cual
#      en Slack y en Discord sin transformar nada.
BOOKING_WEBHOOK_URL=

# ── 3. Correo vía Resend (https://resend.com, plan gratuito)
#      BOOKING_EMAIL_TO acepta varios separados por coma.
RESEND_API_KEY=
BOOKING_EMAIL_TO=
BOOKING_EMAIL_FROM=WorldBrain <avisos@ultravelozmente.com>
