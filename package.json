{
  "name": "ultravelozmente",
  "version": "2.0.2",
  "private": true,
  "description": "Sitio WorldBrain México — Express server + Eleventy build",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "build": "echo 'Sin build: Express sirve archivos estáticos de la raíz'",
    "build:eleventy": "eleventy",
    "dev": "eleventy --serve --quiet",
    "check:external": "grep -rn 'randomuser\\|pravatar' src/ && exit 1 || echo '✓ Sin dependencias de imágenes externas'",
    "seo:whatsapp": "node scripts/normalize-whatsapp.js",
    "seo:testimonials": "node scripts/sync-verified-testimonials.js",
    "seo:rebuild-testimonials": "node scripts/rebuild-testimonials.js",
    "seo:apply": "node scripts/apply-seo.js",
    "seo:audit": "node scripts/seo-audit.js",
    "seo:fix": "npm run seo:rebuild-testimonials && npm run seo:testimonials && npm run seo:whatsapp && npm run seo:apply && npm run seo:audit",
    "seo:verify-generated": "node scripts/apply-seo.js && git diff --exit-code"
  },
  "dependencies": {
    "capi-param-builder-nodejs": "^1.0.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "sanitize-html": "2.17.5"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "jsdom": "26.1.0"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "body-parser": "1.20.6",
    "qs": "6.15.3",
    "brace-expansion": "1.1.18"
  }
}
